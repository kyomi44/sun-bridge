    "automated_review": {"status": "unknown", "platform": null, "eligibility_note": "Training only."}, "email_event_coverage": "unknown"
  },
  "verification": {"status": "synthetic", "last_checked": null, "note": "Every email, address, person and identifier in the training dataset is fictional. These tests do not measure performance on a real AHJ."},
