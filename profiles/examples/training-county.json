{
  "schema_version": 1,
  "id": "example-training-county",
  "name": "Example County — fictional training authority",
  "jurisdiction": {"country": "US", "state": null, "county": "Example County", "city": null, "level": "county", "parent_id": null, "coverage_note": "Fictional training authority. Do not use this profile to identify a real property jurisdiction."},
  "permit_types": ["solar", "electrical"],
  "capabilities": {
